{
  "expo": {
    "name": "Ippomed",
    "icon": "./public/brand/ippomed-emblem.png",
    "slug": "medquiz",
    "scheme": "medquiz",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.medquiz.app"
    },
    "android": {
      "package": "fr.medquiz.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Ippomed — Comprendre pour mieux soigner",
      "favicon": "./public/brand/ippomed-emblem.png"
    },
    "plugins": ["expo-router", "expo-status-bar"]
  }
}
