{
  "expo": {
    "name": "Ippomed",
    "icon": "./public/brand/ippomed-emblem.png",
    "slug": "medquiz",
    "scheme": "medquiz",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.medquiz.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleLocalizations": [
          "fr",
          "en"
        ]
      }
    },
    "android": {
      "package": "fr.medquiz.app",
      "versionCode": 1,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Ippomed — Comprendre pour mieux soigner",
      "favicon": "./public/brand/ippomed-emblem.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4e62f61a-560f-4030-81de-514b26120b00"
      }
    },
    "owner": "hikmamif"
  }
}
